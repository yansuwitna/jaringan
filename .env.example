# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ==============================================================================
# DATABASE CONFIGURATION (PRISMA)
# ==============================================================================
# PENTING: Jika mengganti provider database selain SQLite (misal MySQL / PostgreSQL),
# Anda juga perlu mengubah 'provider' di file `prisma/schema.prisma`:
#
#   datasource db {
#     provider = "sqlite" // Ganti menjadi: "mysql" atau "postgresql"
#     url      = env("DATABASE_URL")
#   }
#
# Lalu jalankan perintah:
#   npx prisma db push
#   npx prisma generate
# ==============================================================================

# 1. SQLite (Default - File lokal tanpa perlu server database terpisah)
#PROVIDER="sqlite"; 
#DATABASE_URL="file:./dev.db"

# 2. PostgreSQL (Contoh jika menggunakan PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
#PROVIDER="postgresql";
# DATABASE_URL="postgresql://postgres:password123@localhost:5432/netipam?schema=public"

# 3. MySQL / MariaDB (Contoh jika menggunakan MySQL)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
PROVIDER="mysql"
DB_USER=admin
DB_PASS="Admin123!%40%23"
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nana_jaringan

# Gabungkan menjadi DATABASE_URL
DATABASE_URL="mysql://${DB_USER}:${DB_PASS}@${DB_HOST}:${DB_PORT}/${DB_NAME}"